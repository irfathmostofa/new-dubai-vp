# Supabase > Project Settings > API
# Both values are safe to expose in the browser: Row Level Security protects the data.
# NEVER put the service_role key in a VITE_ variable or commit it.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# Email (Resend) is configured as Supabase secrets, not here:
#   supabase secrets set RESEND_API_KEY=re_xxx RESEND_FROM_EMAIL="Vape Dubai King <orders@yourdomain.com>"
